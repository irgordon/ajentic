{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajentic.dev/schemas/intents/operator-intent.schema.json",
  "title": "Operator Intent",
  "description": "Base typed operator intent submitted by UI or CLI.",
  "type": "object",
  "required": [
    "schema_version",
    "intent_id",
    "intent_type",
    "timestamp",
    "actor",
    "target",
    "reason",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_type": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "retry",
        "memory_write",
        "memory_delete",
        "run_start",
        "run_stop",
        "tool_request",
        "policy_check",
        "state_transition_request",
        "context_rebuild_request",
        "replay_request",
        "memory_snapshot_request",
        "memory_disable_request"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "ui",
            "cli",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "run",
            "candidate",
            "memory_entry",
            "context_packet",
            "ledger_event",
            "replay_report",
            "validation_report",
            "policy_check",
            "state",
            "tool"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "approval_binding": {
      "description": "Exact-action binding required before any future executable approval; metadata does not execute the action.",
      "type": ["object", "null"],
      "required": [
        "tool",
        "canonical_argument_digest",
        "target",
        "disclosed_data_digest",
        "risk_class",
        "reversibility",
        "expected_cost_microunits",
        "run_digest",
        "task_digest",
        "candidate_digest",
        "context_digest",
        "operator_id",
        "expires_after_revision",
        "nonce"
      ],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "canonical_argument_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "target": { "type": "string", "minLength": 1 },
        "recipient": { "type": ["string", "null"] },
        "disclosed_data_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "risk_class": { "type": "string", "enum": ["READ_ONLY", "REVERSIBLE_MUTATION", "IRREVERSIBLE_MUTATION", "EXTERNAL_COMMUNICATION"] },
        "reversibility": { "type": "string", "enum": ["REVERSIBLE", "COMPENSATABLE", "IRREVERSIBLE"] },
        "expected_cost_microunits": { "type": "integer", "minimum": 0 },
        "run_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "task_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "candidate_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "context_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "operator_id": { "type": "string", "minLength": 1 },
        "expires_after_revision": { "type": "integer", "minimum": 1 },
        "nonce": { "type": "string", "minLength": 1 },
        "previous_approval_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
