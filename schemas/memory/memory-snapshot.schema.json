{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajentic.dev/schemas/memory/memory-snapshot.schema.json",
  "title": "Memory Snapshot",
  "description": "Snapshot of governed memory lifecycle state.",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "created_at", "entries"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": { "$ref": "memory-entry.schema.json" }
    }
  },
  "additionalProperties": false
}
