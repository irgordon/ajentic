{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajentic.dev/schemas/traces/run-trace.schema.json",
  "title": "Run Trace",
  "description": "Run trace projection shape.",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "run_id",
    "task_contract",
    "events",
    "validation_reports",
    "replay_reports",
    "action_outcomes",
    "claim_reports",
    "validation_receipt_refs",
    "policy_receipt_refs",
    "replay_receipt_refs",
    "authoritative_result",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_contract": {
      "$ref": "../tasks/task-contract.schema.json"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validation_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "validation_report_id",
          "run_id",
          "status",
          "checks",
          "summary"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "validation_report_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "blocked",
              "unknown"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "check_id",
                "status",
                "message"
              ],
              "properties": {
                "check_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "fail",
                    "blocked",
                    "unknown"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "replay_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "replay_report_id",
          "run_id",
          "status",
          "integrity",
          "events_replayed",
          "summary"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "replay_report_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "replayable",
              "not_replayable",
              "failed",
              "unknown"
            ]
          },
          "integrity": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "incomplete",
              "conflicting",
              "unknown"
            ]
          },
          "events_replayed": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "action_outcomes": {
      "type": "array",
      "items": { "$ref": "action-outcome.schema.json" }
    },
    "claim_reports": {
      "type": "array",
      "items": { "$ref": "claim-report.schema.json" }
    },
    "validation_receipt_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "policy_receipt_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "replay_receipt_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "authoritative_result": {
      "type": "object",
      "required": ["status", "material_errors", "partial_side_effects", "unmet_success_criteria", "unresolved_uncertainty"],
      "properties": {
        "status": { "type": "string", "enum": ["SUCCEEDED", "PARTIAL", "FAILED", "BLOCKED", "UNKNOWN", "NOT_ATTEMPTED"] },
        "material_errors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "partial_side_effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "unmet_success_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "unresolved_uncertainty": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
