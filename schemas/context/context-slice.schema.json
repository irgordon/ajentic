{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajentic.dev/schemas/context/context-slice.schema.json",
  "title": "Context Slice",
  "description": "Individual model-visible context slice.",
  "type": "object",
  "required": [
    "schema_version",
    "slice_id",
    "view_type",
    "truth_dimension",
    "source_path",
    "content",
    "provenance",
    "content_role",
    "authority_level",
    "trust_classification",
    "source_digest",
    "source_revision",
    "selector_authorization",
    "selection_reason",
    "sensitivity",
    "conflict_refs",
    "superseded_by",
    "quarantine_status",
    "injection_detection_findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "slice_id": {
      "type": "string",
      "minLength": 1
    },
    "view_type": {
      "type": "string",
      "enum": [
        "code",
        "memory",
        "docs",
        "schema",
        "diff",
        "task",
        "example",
        "system",
        "tool_output",
        "model_output"
      ]
    },
    "truth_dimension": {
      "type": "string",
      "enum": [
        "normative",
        "structural",
        "planned",
        "historical",
        "procedural",
        "executable",
        "contract",
        "data",
        "example",
        "orientation",
        "navigation"
      ]
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string"
    },
    "content_role": {
      "type": "string",
      "enum": ["INSTRUCTION", "DATA", "EVIDENCE", "EXAMPLE"]
    },
    "authority_level": {
      "type": "string",
      "enum": ["AUTHORITATIVE", "DELEGATED", "NON_AUTHORITATIVE"]
    },
    "trust_classification": {
      "type": "string",
      "enum": ["TRUSTED", "UNTRUSTED", "QUARANTINED"]
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_revision": { "type": "string", "minLength": 1 },
    "selector_authorization": { "type": "string", "minLength": 1 },
    "selection_reason": { "type": "string", "minLength": 1 },
    "sensitivity": {
      "type": "string",
      "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
    },
    "conflict_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "superseded_by": { "type": ["string", "null"] },
    "quarantine_status": { "type": "boolean" },
    "injection_detection_findings": {
      "description": "Advisory findings only; absence does not grant authority.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "selected_by"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "selected_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
